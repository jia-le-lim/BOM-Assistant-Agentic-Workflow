# Run npm run setup:auth to enable local sign-in with existing pilot accounts.
# Leave unset only when intentionally using the localhost demo identities.
# PILOT_AUTH_REQUIRED=1
# PILOT_AUTH_FILE=.local/pilot-auth.json
# For standalone npm development; make dev sets this from BACKEND_PORT.
# BACKEND_URL=http://127.0.0.1:8012
