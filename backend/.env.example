# Copy to backend/.env and fill in. NEVER commit the filled copy.
# .gitignore already excludes backend/data/; add .env there too if you create one.

# --- Supabase over HTTPS (transport A, default) ------------------------
# Set these and leave DATABASE_URL unset: the backend then reaches Supabase
# through the exec_sql RPC over ordinary HTTPS -- no database password and no
# proxy tunnel (app/rest_conn.py). Trade-off: one HTTP call is one
# transaction, so multi-statement routes are no longer atomic.
# SUPABASE_URL=https://qiwdjbsrtxeorzpcqmxy.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=               # server-only. Dashboard > API Keys.
#
# The anon key CANNOT drive the backend: exec_sql is granted to service_role
# only, deliberately -- it is published to browsers, and a public key that runs
# arbitrary SQL is a public database. Keep it for browser-side use under RLS.
# SUPABASE_ANON_KEY=sb_publishable_...

# --- Direct Postgres (transport B) -------------------------------------
# Stronger than transport A -- real multi-statement transactions -- but needs
# the database password, and a tunnel wherever egress is proxied. Set this and
# it wins over the Supabase REST settings above.
# The application runs on Supabase Postgres. There is no SQLite fallback:
# without DATABASE_URL the server refuses to start, rather than silently
# writing engineers' decisions to a local file nobody else can see.
# (SQLite survives only as the test backend, which opts in via
# BOM_ALLOW_SQLITE=1 set by tests/conftest.py. Do not set that by hand.)
#
# Project: bom-review-assistant (qiwdjbsrtxeorzpcqmxy), region ap-southeast-1.
# Password: Supabase Dashboard > Project Settings > Database.
# The pooler requires the tenant-qualified user `postgres.<project_ref>`.
#
# VIA PROXY TUNNEL -- this machine. All egress must traverse
# proxy-png.intel.com:912 and libpq has no HTTP-proxy support, so start
#   python backend/scripts/proxy_tunnel.py --listen-port 5432
# in another terminal, then point at 127.0.0.1:
DATABASE_URL=postgresql://postgres.qiwdjbsrtxeorzpcqmxy:<PASSWORD>@127.0.0.1:5432/postgres?sslmode=require
#
# DIRECT -- deployed backend with normal egress, no tunnel:
# DATABASE_URL=postgresql://postgres.qiwdjbsrtxeorzpcqmxy:<PASSWORD>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- LLM ---------------------------------------------------------------
# Unset -> EchoProvider: deterministic, offline, no API calls. Tests rely on it.
# Set   -> any OpenAI-compatible endpoint. PRD section 15 question 2 (approval
#          to send this data outside Intel) is still open.
# DeepSeek (current choice). Use deepseek-chat, not deepseek-reasoner: the
# agent loop needs function calling.
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_API_KEY=
# LLM_TIMEOUT_S=60

# Mask PRD 5.1 sensitive fields (unitprice, supplier_name, engineer names)
# before they enter a prompt. Off by default because the approved endpoint is
# internal. Turn ON for any external endpoint.
# LLM_REDACT_PROMPTS=1

# HTTP proxy. httpx picks this up via trust_env; mandatory on this network.
# HTTPS_PROXY=http://proxy-png.intel.com:912

# --- mem0 recall layer (optional, off) ---------------------------------
# Advisory recall of engineer working preferences only. Never a system record,
# never the basis of a proposed value. Needs `pip install mem0ai` and direct
# Postgres egress (its pgvector backend opens its own psycopg connection).
# MEM0_ENABLED=0
# MEM0_DATABASE_URL=          # defaults to DATABASE_URL

# --- ML ----------------------------------------------------------------
# Where triage model artifacts are looked up. Empty today: no model is trained.
# BOM_MODEL_DIR=backend/models
