FROM cloudflare/cloudflared:latest@sha256:ff69a2225ad7c6f85ed84fbd5f3087df46202426b2388ec60214098e0adf05e9 AS cloudflared
FROM python:3.13-slim-bookworm@sha256:ed86c82274b3c69b52fb5820f358f0bd7df0b603332063cb5c6e32bd220c3e6e

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared
COPY cloudflared_proxy.py /app/cloudflared_proxy.py
USER 10001:10001
HEALTHCHECK --interval=15s --timeout=5s --start-period=70s --retries=3 \
    CMD ["python", "-c", "import urllib.request; o=urllib.request.build_opener(urllib.request.ProxyHandler({})); o.open('http://127.0.0.1:20241/ready',timeout=3).close()"]
ENTRYPOINT ["python", "/app/cloudflared_proxy.py"]
CMD ["--runtime-dir", "/runtime", "--cloudflared", "/usr/local/bin/cloudflared", "--origin", "http://pilot-gateway:8080", "--metrics-port", "20241", "--metrics-host", "0.0.0.0", "--log-stdout"]
