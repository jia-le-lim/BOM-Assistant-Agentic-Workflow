# Supabase Connect > Session pooler (port 5432), NOT transaction pooler 6543.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
# If your approved proxy tunnel runs on the Docker Desktop host, use
# host.docker.internal:5432 instead of localhost in the migration connection.
