# Python tooling
.venv/
__pycache__/
*.pyc

# Analysis intermediates and extracts.
# These contain unitprice, supplier and engineer-name data that PRD 5.1
# classifies as sensitive -- keep them out of version control.
analysis/output/

# Backend local database (contains ingested BOM data -- same sensitivity)
backend/data/
*.db

# Secrets. backend/.env.example is the committed template; the filled copy
# holds the Supabase database password and the LLM API key.
.env
.env.*
!.env.example
!backend/.env.example

# Trained model artifacts (not yet produced; see backend/app/scoring.py)
backend/models/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/shots/
frontend/debug*.mjs
