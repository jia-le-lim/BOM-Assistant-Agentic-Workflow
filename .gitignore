# Python tooling
.venv/
.venv-ollama/
supabase/.temp/
__pycache__/
*.pyc

# Analysis intermediates and extracts.
# These contain unitprice, supplier and engineer-name data that PRD 5.1
# classifies as sensitive -- keep them out of version control.

# Raw monthly BOM workbooks -- 100s of MB of empty-cell bloat and hold sensitive
# unitprice/supplier/engineer data; also exceed GitHub's 100MB limit. Local only.
BOM table/*.xlsx
# Historical archive contains source business records; retain it locally.
BOM table/BOM Review Archive 1.csv

# Backend local database (contains ingested BOM data -- same sensitivity)
backend/data/
*.db

# Secrets. backend/.env.example is the committed template; the filled copy
# holds the Supabase database password and the LLM API key.
.env
.env.*
!.env.example
!backend/.env.example

# Trained model artifacts (not yet produced; see backend/app/scoring.py)
backend/models/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/shots/
frontend/debug*.mjs

# Analysis outputs are regenerated by analysis/s*.py and carry unitprice /
# supplier / machine_type columns PRD 5.1 calls sensitive. Local only.
analysis/output/

# Internal exports contain credentials and business data.
BOM_HANDOVER_*/
